# Copy this file to .env and fill in your own values.

# Optional: enables the multi-step AI planner through OpenRouter.
# Create a key at https://openrouter.ai/keys
# The default model is OpenRouter's free-model router; you can set a specific model slug.
# Leave the key blank to use the rule-based fallback planner.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional n8n demo webhooks. Import the example workflows from ../n8n/workflows,
# activate them, then paste their Production URLs here and restart the backend.
N8N_PLAN_WEBHOOK_URL=
N8N_REMINDER_WEBHOOK_URL=

# Used to sign login sessions. Set this to any long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated emails allowed to manage the trek catalogue.
ADMIN_EMAILS=admin@example.com

PORT=4000
